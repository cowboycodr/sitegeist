{
	"name": "sitegeist",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"preview": "pnpm run build && wrangler dev",
		"test": "node --test tests/*.test.js",
		"cf-typegen": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"benchmark:prepare": "node scripts/benchmark/prepare-run.mjs",
		"benchmark:build-site": "node scripts/benchmark/build-static.mjs",
		"benchmark:import": "node scripts/benchmark/import-site.mjs",
		"benchmark:audit": "node scripts/benchmark/audit-duplicates.mjs --submissions benchmark/submissions --output benchmark/reports/exact-duplicates.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.110.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/eb-garamond": "^5.2.7",
		"@lucide/svelte": "^1.24.0"
	}
}
